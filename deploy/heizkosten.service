[Unit]
Description=Heizkosten-Webseite
After=network.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
Environment=HEIZKOSTEN_DATA=@DATA@
Environment=PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=@REPO@/venv/bin/python run.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
